---
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "../config";
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner">
		<div>
			<strong>{siteConfig.title}</strong>
			<p>{siteConfig.subtitle}</p>
		</div>
		<nav aria-label="页脚链接">
			<a href="/rss.xml"><Icon name="fa6-solid:rss" />RSS</a>
			<a href="/atom.xml"><Icon name="material-symbols:rss-feed-rounded" />Atom</a>
			<a href={profileConfig.links[0]?.url || "#"} target="_blank" rel="me noopener"><Icon name="fa6-brands:github" />GitHub</a>
		</nav>
	</div>
	<div class="footer-meta">© {year} {profileConfig.name} · Powered by Astro & Mizuki · 备案信息预留</div>
</footer>
