---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getTagList } from "../../utils/content-utils";
import { getTagUrl } from "../../utils/url-utils";

const tags = await getTagList();
---

<MainGridLayout title="标签" description="按标签浏览半醒观测站的文章">
	<section class="taxonomy-page">
		<header class="section-heading">
			<p>TAGS</p>
			<h1>标签</h1>
			<span>从关键词进入不同的观察切面</span>
		</header>
		<div class="taxonomy-grid">
			{tags.map((tag) => (
				<a href={getTagUrl(tag.name)} class="taxonomy-item ha-ripple">
					<Icon name="material-symbols:sell-outline" />
					<strong>{tag.name}</strong>
					<span>{tag.count} 篇</span>
				</a>
			))}
		</div>
	</section>
</MainGridLayout>
