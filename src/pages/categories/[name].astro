---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import PostPage from "../../components/PostPage.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../../utils/content-utils";

export const getStaticPaths = (async () => {
	const posts = await getCollection("posts", ({ data }) => !data.draft);
	const categories = [...new Set(posts.map((post) => post.data.category).filter(Boolean))];
	return categories.map((name) => ({ params: { name: name as string }, props: { name } }));
}) satisfies GetStaticPaths;

const { name } = Astro.props;
const posts = (await getSortedPosts()).filter((post) => post.data.category === name);
---

<MainGridLayout title={`分类：${name}`} description={`${name} 分类下的文章`}>
	<header class="section-heading"><p>CATEGORY</p><h1>{name}</h1><span>共 {posts.length} 篇文章</span></header>
	<PostPage page={{ data: posts }} />
</MainGridLayout>
